@@ -210,6 +210,21 @@ static const char* s_discord_presence_large_image_text = "PCSX2 PS2 Emulator";
 // Making GSDumpReplayer.h dependent on R5900.h is a no-no, since the GS uses it.
 extern R5900cpu GSDumpReplayerCpu;
 
+// ps2native host mode (see VMManager::SetNativeHostCPUs).
+static R5900cpu* s_native_ee_cpu = nullptr;
+static R3000Acpu* s_native_iop_cpu = nullptr;
+
+void VMManager::SetNativeHostCPUs(R5900cpu* ee, R3000Acpu* iop)
+{
+	s_native_ee_cpu = ee;
+	s_native_iop_cpu = iop;
+}
+
+bool VMManager::IsNativeHost()
+{
+	return s_native_ee_cpu != nullptr;
+}
